# Copy file này thành .env rồi chỉnh theo môi trường của bạn.
# Có thể bỏ qua .env và set biến môi trường trực tiếp trong shell.

# Cổng HTTP của server
PORT=3000

# BẮT BUỘC đổi khi deploy thật: chuỗi ngẫu nhiên dài (>= 32 ký tự)
SESSION_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai-va-bi-mat

# File SQLite (tự tạo thư mục nếu chưa có). Bỏ trống để dùng ./data/app.db
DB_PATH=./data/app.db

# development | production
NODE_ENV=development

# Bật để log mọi câu SQL ra console (chỉ dùng khi debug)
# DB_DEBUG=1
