# Copy file này thành .env rồi chỉnh theo môi trường của bạn.
# Có thể bỏ qua .env và set biến môi trường trực tiếp trong shell.

# Cổng HTTP của server
PORT=3000

# BẮT BUỘC đổi khi deploy thật: chuỗi ngẫu nhiên dài (>= 32 ký tự)
SESSION_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai-va-bi-mat

# File SQLite (tự tạo thư mục nếu chưa có). Bỏ trống để dùng ./data/app.db
DB_PATH=./data/app.db

# development | production
NODE_ENV=development

# Bật để log mọi câu SQL ra console (chỉ dùng khi debug)
# DB_DEBUG=1

# ===== Bot chuyên gia nông nghiệp (Trợ lý AI) =====
# Không set LLM_API_KEY (hoặc LLM_PROVIDER=off) → bot trả lời bằng kiến thức
# có sẵn (rule-based, chạy offline). Có key → bot trả lời bằng LLM, kèm stream realtime.
# LLM_PROVIDER=off            # off | gemini | openai (mặc định: gemini nếu có key)
# LLM_API_KEY=                # Gemini: key từ https://aistudio.google.com/apikey
# LLM_MODEL=gemini-3.1-flash-lite  # nhanh và nhẹ; hoặc deepseek-chat, gemini-3.5-flash... tùy provider
# LLM_BASE_URL=https://api.deepseek.com  # chỉ dùng khi LLM_PROVIDER=openai (DeepSeek/Ollama...)

# ===== API fallback: bot thử API này khi LLM chính lỗi/quá tải/timeout =====
# Không set → bot nhảy thẳng về rule-based khi LLM chính lỗi.
# Ví dụ OpenRouter free: key tại https://openrouter.ai/keys (model nào cũng có bản :free);
# hoặc Groq: key tại https://console.groq.com/keys, model gpt-oss-120b.
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1

# ===== API fallback bậc 2 (tùy chọn): thử sau LLM_FALLBACK_*, trước rule-based =====
# Thứ tự trả lời: LLM chính → LLM_FALLBACK_* → LLM_FALLBACK2_* → rule-based.
# LLM_FALLBACK2_PROVIDER=openai
# LLM_FALLBACK2_API_KEY=
# LLM_FALLBACK2_MODEL=gpt-oss-120b
# LLM_FALLBACK2_BASE_URL=https://api.groq.com/openai/v1

# ===== Giờ hành chính của bot (OFFICE_HOURS, dạng "8-17", mặc định 8-17) =====
# Ngoài khung giờ này bot không gọi LLM/KB mà trả lời cố định nhắc khách để lại
# lời nhắn (admin xử lý trong giờ). "0-24" = bot trả lời mọi lúc (dùng cho test).
# OFFICE_HOURS=8-17

# ===== Job dọn rác uploads (public/uploads) =====
# Định kỳ xóa file upload không còn được tin nhắn/nhật ký tham chiếu.
# UPLOAD_CLEANUP_INTERVAL_HOURS=24  # mỗi bao lâu dọn 1 lần; 0 = tắt
# UPLOAD_CLEANUP_MIN_AGE_HOURS=24   # chỉ xóa file cũ hơn mức này (tránh xóa file đang upload)

